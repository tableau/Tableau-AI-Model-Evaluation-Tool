        { "caption": "Region", "datatype": "string" },
        { "caption": "Category", "datatype": "string" },
        { "caption": "Profit", "datatype": "real" }
      ]
    }
  },

  "equals_cases": [
    {
      "name": "equals_exact_intent",
      "utterance": "create a calc",
      "datasource": "taxi",
      "expected": "NLQ_TO_NEW_CALCULATED_FIELD",
      "actual": "NLQ_TO_NEW_CALCULATED_FIELD"
    },
    {
      "name": "equals_mismatch_intent",
      "utterance": "create a calc",
      "datasource": "taxi",
      "expected": "NLQ_TO_NEW_CALCULATED_FIELD",
      "actual": "NLQ_TO_VIZ"
    },
    {
      "name": "equals_actual_null",
      "utterance": "create a calc",
      "datasource": "taxi",
      "expected": "NLQ_TO_NEW_CALCULATED_FIELD",
      "actual": null
