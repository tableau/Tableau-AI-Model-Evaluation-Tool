    "utterance": "create a calc to flag weekdays only",
    "datasource": "chicago-taxi-trips-2024-calcs",
    "expected": {
      "intent": "NLQ_TO_NEW_CALCULATED_FIELD",
      "calculatedFieldFormula": {
        "formula": "IF DATENAME('weekday', [Trip Start Timestamp]) <> 'Saturday' AND DATENAME('weekday', [Trip Start Timestamp]) <> 'Sunday' THEN 'Weekday' ELSE 'Weekend' END",
        "caption": null
      }
    },
    "actual": {
      "intent": "NLQ_TO_NEW_CALCULATED_FIELD",
      "calculatedFieldFormula": {
        "formula": "IF DATEPART('weekday', [Trip Start Timestamp]) IN (2, 3, 4, 5, 6) THEN 1 ELSE 0 END",
        "caption": "Flag: Weekday",
        "type": ""
      },
      "user_friendly_reply": "This calculation flags records that occur on weekdays (Monday–Friday) by returning 1, and 0 for weekends (Saturday–Sunday). It uses DATEPART to extract the day of the week from the [Trip Start Timestamp] field, where 2=Monday through 6=Friday. You can use this flag to filter, color, or aggregate weekday trips specifically."
