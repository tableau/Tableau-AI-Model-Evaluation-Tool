        { "fieldName": "Region" }
      ]
    }
  ],

  "field_rank_scorer_cases": [
    {
      "name": "rank_full_hit_top1",
      "utterance": "sales and profit",
      "expected_formula": "[Sales] + [Profit]",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Sales", "score": 0.95, "filtered": false },
            { "fieldName": "Profit", "score": 0.90, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "rank_relevant_at_rank2",
      "utterance": "sales",
      "expected_formula": "[Sales]",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Region", "score": 0.99, "filtered": false },
            { "fieldName": "Sales", "score": 0.80, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "rank_relevant_at_rank6",
      "utterance": "sales",
      "expected_formula": "[Sales]",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "F1", "score": 0.99, "filtered": false },
            { "fieldName": "F2", "score": 0.98, "filtered": false },
            { "fieldName": "F3", "score": 0.97, "filtered": false },
            { "fieldName": "F4", "score": 0.96, "filtered": false },
            { "fieldName": "F5", "score": 0.95, "filtered": false },
            { "fieldName": "Sales", "score": 0.50, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "rank_complete_miss",
      "utterance": "sales",
      "expected_formula": "[Sales]",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Region", "score": 0.99, "filtered": false },
            { "fieldName": "Category", "score": 0.80, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "rank_tie_relevant_and_nonrelevant_equal",
      "utterance": "sales",
      "expected_formula": "[Sales]",
      "_tie_note": "PRE-FLAGGED DIVERGENCE. Sales (relevant) and Region (non-relevant) both score 0.5. ranx tie-break decides the rank of Sales; captures whether TS ir.ts (non-relevant before relevant) matches ranx.",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Region", "score": 0.5, "filtered": false },
            { "fieldName": "Sales", "score": 0.5, "filtered": false },
            { "fieldName": "Category", "score": 0.2, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "rank_tie_all_equal",
      "utterance": "sales",
      "expected_formula": "[Sales]",
      "_tie_note": "PRE-FLAGGED DIVERGENCE. Three fields all at 0.5, one relevant (Sales).",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "A", "score": 0.5, "filtered": false },
            { "fieldName": "B", "score": 0.5, "filtered": false },
            { "fieldName": "Sales", "score": 0.5, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "rank_multi_chunk",
      "utterance": "sales and profit",
      "expected_formula": "[Sales] + [Profit]",
      "_note": "two chunks: chunk-1 has Sales at top; chunk-2 misses. map/mrr/hit_rate are averaged across the 2 chunk-queries.",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Sales", "score": 0.9, "filtered": false },
            { "fieldName": "Profit", "score": 0.85, "filtered": false }
          ]
        },
        {
          "chunk": "chunk-2",
          "matches": [
            { "fieldName": "Region", "score": 0.7, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "rank_chunk_all_filtered_empty_run",
      "utterance": "sales",
      "expected_formula": "[Sales]",
      "_note": "chunk with all matches filtered -> empty run for that chunk. make_comparable keeps it as a 0-scoring query.",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Sales", "score": 0.9, "filtered": true }
          ]
        }
      ]
    },
    {
      "name": "rank_no_chunks_flat_only",
      "utterance": "sales",
      "expected_formula": "[Sales]",
      "_note": "only flat matched fields (no chunk) -> qrels empty -> Python returns [].",
      "semanticsearch_results": [
        { "fieldName": "Sales" }
      ]
    }
  ]
}
