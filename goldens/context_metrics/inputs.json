          { "field": "Region" }
        ]
      },
      "semanticsearch_results": [
        { "fieldName": "Sales" },
        { "fieldName": "Region" }
      ]
    },
    {
      "name": "spec_partial_hit",
      "utterance": "sales by region and category",
      "notional_spec": {
        "encodings": [
          { "field": "Sales" },
          { "field": "Region" },
          { "field": "Category" }
        ]
      },
      "semanticsearch_results": [
        { "fieldName": "Sales" }
      ]
    },
    {
      "name": "spec_complete_miss",
      "utterance": "sales by region",
      "notional_spec": {
        "encodings": [
          { "field": "Sales" },
          { "field": "Region" }
        ]
      },
      "semanticsearch_results": [
        { "fieldName": "Profit" }
      ]
    },
    {
      "name": "spec_empty_matched_list",
      "utterance": "sales by region",
      "notional_spec": {
        "encodings": [
          { "field": "Sales" },
          { "field": "Region" }
        ]
      },
      "semanticsearch_results": []
    },
    {
      "name": "spec_empty_expected_fields",
      "utterance": "empty spec",
      "notional_spec": { "encodings": [] },
      "semanticsearch_results": [
        { "fieldName": "Sales" }
      ]
    },
    {
      "name": "spec_caption_key",
      "utterance": "sales by region",
      "notional_spec": {
        "marks": [
          { "caption": "Sales" },
          { "caption": "Region" }
        ]
      },
      "semanticsearch_results": [
