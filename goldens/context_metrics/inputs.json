{
  "_note": "Synthetic fixtures for the ect-server context metrics (SemanticSearchAccuracy, SpecSemanticSearchAccuracy, FieldRankScorer). expected/actual/data mirror how MetricConfiguration.compute + _compute read them. For key='formula' metrics (SemanticSearchAccuracy, FieldRankScorer) the calc formula string is passed under {formula: ...}; the class parses it via ParseCalcsFormula into a set of fields. SpecSemanticSearchAccuracy has NO key: its expected is the notionalSpec object and it reads find_sub_entries(expected, ['field','caption']). data['semanticsearch_results'] is the _context.opensearch_query.matched list, a mix of flat {fieldName} entries and {chunk, matches:[{fieldName, score, filtered}]} entries. Only match.filtered === False counts.",

  "semantic_search_accuracy_cases": [
    {
      "name": "clean_full_hit_flat",
      "utterance": "sum of sales and profit",
      "expected_formula": "[Sales] + [Profit]",
      "semanticsearch_results": [
        { "fieldName": "Sales" },
        { "fieldName": "Profit" }
      ]
    },
    {
      "name": "clean_full_hit_chunk",
      "utterance": "sum of sales and profit",
      "expected_formula": "[Sales] + [Profit]",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Sales", "score": 0.9, "filtered": false },
            { "fieldName": "Profit", "score": 0.8, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "partial_hit",
      "utterance": "sales profit discount",
      "expected_formula": "[Sales] + [Profit] + [Discount]",
      "semanticsearch_results": [
        { "fieldName": "Sales" },
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Profit", "score": 0.7, "filtered": false }
          ]
        }
      ]
    },
    {
      "name": "complete_miss",
      "utterance": "sales and profit",
      "expected_formula": "[Sales] + [Profit]",
      "semanticsearch_results": [
        { "fieldName": "Region" },
        { "fieldName": "Category" }
      ]
    },
    {
      "name": "empty_matched_list",
      "utterance": "sales and profit",
      "expected_formula": "[Sales] + [Profit]",
      "semanticsearch_results": []
    },
    {
      "name": "null_matched",
      "utterance": "sales and profit",
      "expected_formula": "[Sales] + [Profit]",
      "semanticsearch_results": null
    },
    {
      "name": "empty_expected_fields",
      "utterance": "no fields",
      "expected_formula": "",
      "semanticsearch_results": [
        { "fieldName": "Sales" }
      ]
    },
    {
      "name": "filtered_match_excluded",
      "utterance": "sales and profit",
      "expected_formula": "[Sales] + [Profit]",
      "semanticsearch_results": [
        {
          "chunk": "chunk-1",
          "matches": [
            { "fieldName": "Sales", "score": 0.9, "filtered": false },
            { "fieldName": "Profit", "score": 0.8, "filtered": true }
          ]
        }
      ]
    }
  ],

  "spec_semantic_search_accuracy_cases": [
    {
      "name": "spec_clean_full_hit",
      "utterance": "sales by region",
      "notional_spec": {
        "encodings": [
