{
  "_description": "Tableau calculation validator regression corpus. Inputs are valid_columns/formula pairs checked against independent reference results in expected.json.",
  "valid_columns": {
    "Sales": "number",
    "Profit": "number",
    "Discount": "number",
    "Quantity": "number",
    "Customer ID": "string",
    "Customer Name": "string",
    "Category": "string",
    "Order Date": "date",
    "Ship Date": "date",
    "Returned": "boolean"
  },
  "cases": [
    { "name": "simple_field", "formula": "[Sales]" },
    { "name": "simple_number_literal", "formula": "42" },
    { "name": "simple_double_literal", "formula": "3.14" },
    { "name": "simple_string_literal", "formula": "\"hello\"" },
    { "name": "simple_boolean_literal", "formula": "TRUE" },
    { "name": "null_literal", "formula": "NULL" },
    { "name": "arith_add_numbers", "formula": "[Sales] + [Profit]" },
    { "name": "arith_sub_numbers", "formula": "[Sales] - [Profit]" },
    { "name": "arith_mul_numbers", "formula": "[Sales] * [Quantity]" },
    { "name": "arith_div_numbers", "formula": "[Sales] / [Quantity]" },
    { "name": "arith_mod_numbers", "formula": "[Quantity] % 2" },
    { "name": "arith_pow_numbers", "formula": "[Sales] ^ 2" },
    { "name": "arith_type_mismatch", "formula": "[Sales] + [Customer Name]" },
    { "name": "unary_minus_number", "formula": "-[Sales]" },
    { "name": "unary_minus_string", "formula": "-[Customer Name]" },
    { "name": "paren_expr", "formula": "([Sales] + [Profit]) * 2" },
    { "name": "nested_paren", "formula": "((([Sales])))" },
    { "name": "aggregate_sum", "formula": "SUM([Sales])" },
    { "name": "aggregate_avg", "formula": "AVG([Sales])" },
    { "name": "aggregate_countd", "formula": "COUNTD([Customer ID])" },
    { "name": "aggregate_min", "formula": "MIN([Sales])" },
    { "name": "aggregate_max", "formula": "MAX([Profit])" },
    { "name": "aggregate_count", "formula": "COUNT([Sales])" },
    { "name": "aggregate_ratio", "formula": "SUM([Sales]) / COUNTD([Customer ID])" },
    { "name": "aggregate_sum_string_mismatch", "formula": "SUM([Customer Name])" },
    { "name": "invalid_field", "formula": "SUM([Bogus])" },
    { "name": "invalid_bare_field", "formula": "[DoesNotExist]" },
    { "name": "unrecognized_function", "formula": "FOObar([Sales])" },
    { "name": "number_func_abs", "formula": "ABS([Profit])" },
    { "name": "number_func_round", "formula": "ROUND([Sales])" },
    { "name": "number_func_type_mismatch", "formula": "ABS([Customer Name])" },
    { "name": "string_func_upper", "formula": "UPPER([Customer Name])" },
    { "name": "string_func_lower", "formula": "LOWER([Category])" },
    { "name": "string_func_len", "formula": "LEN([Customer Name])" },
    { "name": "string_func_trim", "formula": "TRIM([Category])" },
    { "name": "date_func_datepart", "formula": "DATEPART(\"year\", [Order Date])" },
    { "name": "date_func_datediff", "formula": "DATEDIFF(\"day\", [Order Date], [Ship Date])" },
    { "name": "logical_func_isnull", "formula": "ISNULL([Sales])" },
    { "name": "logical_func_isdate", "formula": "ISDATE([Order Date])" },
    { "name": "comparison_numbers", "formula": "[Sales] > [Profit]" },
    { "name": "comparison_eq", "formula": "[Category] = \"Furniture\"" },
    { "name": "comparison_type_mismatch", "formula": "[Sales] = [Category]" },
    { "name": "not_boolean", "formula": "NOT [Returned]" },
    { "name": "not_number_mismatch", "formula": "NOT [Sales]" },
    { "name": "and_expr", "formula": "[Returned] AND ([Sales] > 0)" },
    { "name": "or_expr", "formula": "([Sales] > 0) OR [Returned]" },
    { "name": "if_then_else", "formula": "IF [Sales] > 0 THEN \"pos\" ELSE \"neg\" END" },
    { "name": "if_elseif", "formula": "IF [Sales] > 100 THEN \"hi\" ELSEIF [Sales] > 0 THEN \"lo\" ELSE \"zero\" END" },
    { "name": "if_condition_not_boolean", "formula": "IF [Sales] THEN \"x\" ELSE \"y\" END" },
    { "name": "if_branch_mismatch", "formula": "IF [Sales] > 0 THEN \"pos\" ELSE 1 END" },
    { "name": "case_expr", "formula": "CASE [Category] WHEN \"Furniture\" THEN 1 WHEN \"Tech\" THEN 2 ELSE 0 END" },
    { "name": "case_branch_mismatch", "formula": "CASE [Category] WHEN \"A\" THEN 1 WHEN \"B\" THEN \"two\" END" },
    { "name": "in_list_strings", "formula": "[Category] IN (\"Furniture\", \"Tech\")" },
    { "name": "in_list_type_mismatch", "formula": "[Category] IN (1, 2)" },
    { "name": "ifnull_expr", "formula": "IFNULL([Sales], 0)" },
    { "name": "lod_fixed", "formula": "{FIXED [Category] : SUM([Sales])}" },
    { "name": "lod_include", "formula": "{INCLUDE [Customer ID] : AVG([Sales])}" },
    { "name": "lod_exclude", "formula": "{EXCLUDE [Category] : SUM([Profit])}" },
    { "name": "lod_no_dimensions", "formula": "{FIXED : SUM([Sales])}" },
    { "name": "lod_invalid_dimension", "formula": "{FIXED [Bogus] : SUM([Sales])}" },
    { "name": "nested_functions", "formula": "SUM([Sales]) / SUM([Profit])" },
    { "name": "complex_if_aggregate", "formula": "IF SUM([Sales]) > 1000 THEN \"big\" ELSE \"small\" END" },
    { "name": "string_concat_split", "formula": "SPLIT([Customer Name], \" \", 1)" },
    { "name": "replace_func", "formula": "REPLACE([Category], \"a\", \"b\")" },
    { "name": "zn_func", "formula": "ZN([Sales])" },
    { "name": "int_func", "formula": "INT([Sales])" },
    { "name": "syntax_error_trailing_op", "formula": "SUM([Sales]) +" },
    { "name": "syntax_error_unbalanced_paren", "formula": "SUM([Sales]" },
    { "name": "syntax_error_empty", "formula": "" },
    { "name": "syntax_error_garbage", "formula": "@@@" },
    { "name": "syntax_error_missing_operand", "formula": "[Sales] * * [Profit]" },
    { "name": "general_func_lower_case", "formula": "power([Sales], 2)" },
    { "name": "general_func_str", "formula": "STR([Sales])" },
    { "name": "general_func_contains", "formula": "CONTAINS([Customer Name], \"Smith\")" }
  ]
}
