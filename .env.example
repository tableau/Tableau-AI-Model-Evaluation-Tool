# Tableau AI Model Evaluation Tool local secrets — TEMPLATE. Copy to `.env` and fill in real values.
# `.env` is git-ignored and auto-loaded by Bun (available as process.env.*).
# Agents/tooling should read these via process.env — never paste secret
# values into logs, chat, or committed files.

# --- Tableau Server (PAT auth) ---
TABLEAU_SERVER_URL=https://your-tableau-server.example.com
TABLEAU_SITE_CONTENT_URL=YourSiteContentUrl
TABLEAU_PAT_NAME=your-pat-name
TABLEAU_PAT_SECRET=your-pat-secret

# --- LLM judge (BYOK) ---
JUDGE_PROVIDER=openai            # openai | anthropic | gemini
JUDGE_MODEL=gpt-4.1
OPENAI_API_KEY=sk-...            # or ANTHROPIC_API_KEY / GEMINI_API_KEY per provider
